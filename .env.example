# =============================================================================
# 공통
# =============================================================================
# state 서명(HMAC)과 세션 쿠키 암호화(AES-GCM)에 함께 쓰이는 비밀키.
# 32바이트 이상 필요. 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# =============================================================================
# 치지직 (CHZZK) — 공식 Open API
# https://developers.chzzk.naver.com 에서 앱 등록 후 발급
# =============================================================================
# 주의: 앱 ID/이름에 "chzzk", "치지직", "naver", "네이버" 를 넣을 수 없습니다.
# 주의: 90일간 스코프 사용 이력이 없으면 앱이 자동 삭제됩니다.
# 실제 값은 apps/demo/.env.local 에 넣으세요. 이 파일에는 시크릿을 커밋하지 마세요.
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
# 개발자센터에 등록한 값과 정확히 일치해야 합니다.
CHZZK_REDIRECT_URI=http://localhost:3000/api/auth/chzzk/callback

# =============================================================================
# SOOP (숲) — 공식 Open API
# https://openapi.sooplive.co.kr/apidoc
# =============================================================================
# 주의: 개인 개발자용 키 발급은 "준비 중"이며 파트너 등록이 필요합니다.
# 비워두면 데모의 SOOP 탭은 비공식 익명 모드로만 동작합니다.
SOOP_CLIENT_ID=
SOOP_CLIENT_SECRET=
# SOOP은 인가 요청에 redirect_uri를 싣지 않습니다. 개발자센터에 사전 등록한 값을
# 여기에 동일하게 적어두면 토큰 교환 시 함께 전송합니다.
SOOP_REDIRECT_URI=http://localhost:3000/api/auth/soop/callback

# =============================================================================
# 비공식 API (선택) — 공식 자격증명 없이 채팅/방송정보를 읽을 때만 사용
# =============================================================================
# 치지직 비공식 API용 네이버 세션 쿠키.
# !! 이것은 네이버 계정 전체 세션입니다. 유출 시 계정이 탈취됩니다. !!
# 비워두면 익명(읽기 전용)으로 동작하며, 대부분의 채팅 읽기는 익명으로 충분합니다.
CHZZK_NID_AUT=
CHZZK_NID_SES=

# SOOP 채팅 "전송"에만 필요합니다. 읽기는 자격증명 없이 가능합니다.
SOOP_USER_ID=
SOOP_PASSWORD=
